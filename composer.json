{
    "name": "gorghoa/scenariostate-behat-extension",
    "type": "behat-extension",
    "description": "Scenario shared state extension for Behat",
    "keywords": ["behat", "bdd", "stateless api testing"],
    "license": "MIT",
    "authors": [
        {
            "name": "Rodrigue Villetard",
            "email": "rodrigue.villetard@gmail.com"
        }
    ],

    "require": {
        "php": ">=8.4",
        "behat/behat": "^3.31",
        "symfony/dependency-injection": "^6.4 || ^7.0",
        "symfony/process": "^6.4 || ^7.0",
        "symfony/config": "^6.4 || ^7.0",
        "doctrine/annotations": "^2.0"
    },

    "require-dev": {
        "phpunit/phpunit": "^13.0",
        "phpspec/prophecy-phpunit": "^2.5",
        "roave/security-advisories": "dev-latest"
    },

    "config": {
        "allow-plugins": false,
        "sort-packages": true
    },

    "autoload": {
        "psr-4": {
            "Gorghoa\\ScenarioStateBehatExtension\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Gorghoa\\ScenarioStateBehatExtension\\TestApp\\": "testapp/"
        }
    }
}
